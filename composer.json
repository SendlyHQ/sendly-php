{
  "name": "sendly/sendly-php",
  "description": "Official PHP SDK for the Sendly SMS API",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "sendly",
    "sms",
    "messaging",
    "api",
    "sdk"
  ],
  "homepage": "https://github.com/SendlyHQ/sendly-php",
  "authors": [
    {
      "name": "Sendly",
      "email": "support@sendly.live"
    }
  ],
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.15.2",
    "psr/http-client": "^1.0",
    "guzzlehttp/psr7": "^2.12.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5.62",
    "phpstan/phpstan": "^1.0",
    "squizlabs/php_codesniffer": "^3.13.6"
  },
  "autoload": {
    "psr-4": {
      "Sendly\\": "src/"
    },
    "classmap": [
      "src/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Sendly\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse src --level=8",
    "cs": "phpcs src --standard=PSR12"
  },
  "config": {
    "sort-packages": true
  },
  "version": "4.2.0"
}
